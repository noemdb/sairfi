APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SESSION_COOKIE_NAME="__Host-session"
SESSION_TTL_DAYS="7"
INITIAL_ADMIN_EMAIL="admin@empresa.com"
